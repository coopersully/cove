{
  "name": "cove",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "dev": "pnpm --filter @cove/api dev & pnpm --filter @cove/ws dev & pnpm --filter @cove/web dev & wait",
    "format": "biome format --write .",
    "local:setup": "node scripts/codex-lifecycle.mjs setup",
    "start": "node scripts/codex-lifecycle.mjs start",
    "stop": "node scripts/codex-lifecycle.mjs stop",
    "restart": "node scripts/codex-lifecycle.mjs restart",
    "status": "node scripts/codex-lifecycle.mjs status",
    "logs": "node scripts/codex-lifecycle.mjs logs",
    "verify": "node scripts/codex-lifecycle.mjs verify"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.8.3",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  }
}
